# Local API listener
PORT=8787
XUECHENG_WEB_ORIGIN=http://localhost:4173
XUECHENG_DATABASE_PATH=./data/api/xuecheng.sqlite

# Required for private API access in a deployed environment. Configure these
# values from the selected OpenID Connect provider; never commit client secrets
# or model-provider keys here.
XUECHENG_OIDC_ISSUER=https://issuer.example.com/
XUECHENG_OIDC_AUDIENCE=xuecheng-api
XUECHENG_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
