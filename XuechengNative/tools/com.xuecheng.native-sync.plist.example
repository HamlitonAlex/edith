<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.xuecheng.native-sync</string>
  <key>ProgramArguments</key>
  <array><string>/ABSOLUTE/PATH/TO/edith/XuechengNative/tools/sync_xuecheng.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/tmp/xuecheng-native-sync.log</string>
  <key>StandardErrorPath</key><string>/tmp/xuecheng-native-sync-error.log</string>
</dict>
</plist>
